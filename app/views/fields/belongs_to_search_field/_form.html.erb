<%#
# BelongsToSearchField Form Partial

Renders only the selected record; administrate/components/belongs_to_search.js
loads the other options from `data-url` as the user types.
%>

<div class="field-unit__label">
  <%= f.label field.permitted_attribute %>
</div>
<div class="field-unit__field">
  <%= f.select(field.permitted_attribute,
               options_for_select(field.associated_resource_options, field.selected_option),
               {},
               class: 'js-belongs-to-search-field',
               data: { url: polymorphic_url([namespace, field.associated_class], format: :json) }) %>
</div>
