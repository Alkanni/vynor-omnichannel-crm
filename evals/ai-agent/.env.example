# Copy to .env (git-ignored) and fill in. promptfoo loads .env from this directory; node scripts use --env-file=.env.

# App under test and an administrator access token (Profile Settings → Access Token) of that account.
EVAL_APP_URL=http://127.0.0.1:3301
EVAL_ACCOUNT_ID=1
EVAL_API_ACCESS_TOKEN=

# Judge model for llm-rubric assertions, through an OpenAI-compatible gateway (e.g. 9router).
EVAL_JUDGE_BASE_URL=https://router.example.com/v1
EVAL_JUDGE_MODEL=cx/gpt-6-luna
EVAL_JUDGE_API_KEY=
# Judge of the web search eval's web_claims rubric (promptfooconfig.web.yaml), through the same gateway and key.
EVAL_WEB_JUDGE_MODEL=cx/gpt-5.6-terra

# Keep promptfoo local.
PROMPTFOO_DISABLE_TELEMETRY=1
PROMPTFOO_DISABLE_UPDATE=1
